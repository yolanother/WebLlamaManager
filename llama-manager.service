# Copyright (c) Llama Manager project. Use of this file is governed by the
# LICENSE file in the repository root.
#
# Runs the immutable application from /usr/lib under the dedicated service
# account while granting write access only to the package-created configuration,
# state, cache, and runtime directories. Local overrides belong in the optional
# /etc/llama-manager/llama-manager.env EnvironmentFile.

[Unit]
Description=Llama Manager API and Multi-Model Server
Documentation=https://github.com/yolanother/llama-manager
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=llama-manager
Group=llama-manager
SupplementaryGroups=render video
WorkingDirectory=/usr/lib/llama-manager/api
ExecStartPre=/usr/lib/llama-manager/node/bin/node /usr/lib/llama-manager/scripts/check-node-runtime.mjs
ExecStart=/usr/lib/llama-manager/node/bin/node /usr/lib/llama-manager/api/server.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0007

Environment=NODE_ENV=production
Environment=LLAMA_MANAGER_NODE_BIN=/usr/lib/llama-manager/node/bin/node
Environment=HOME=/var/lib/llama-manager
Environment=LLAMA_MANAGER_PACKAGED=1
Environment=LLAMA_MANAGER_CONFIG_DIR=/etc/llama-manager
Environment=LLAMA_MANAGER_DATA_DIR=/var/lib/llama-manager
Environment=LLAMA_MANAGER_CACHE_DIR=/var/cache/llama-manager
Environment=MODELS_DIR=/var/lib/llama-manager/models
Environment=DS4_GGUF_DIR=/var/lib/llama-manager/models/ds4
Environment=DS4_STATE_DIR=/var/lib/llama-manager/ds4
Environment=DS4_SERVER_BIN=/usr/lib/llama-manager-ds4/bin/ds4-server
Environment=SLOT_SAVE_PATH=/var/cache/llama-manager/slots
Environment=XDG_RUNTIME_DIR=/run/llama-manager
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/llama-manager/llama-manager.env

ConfigurationDirectory=llama-manager
ConfigurationDirectoryMode=0770
StateDirectory=llama-manager
StateDirectoryMode=0770
CacheDirectory=llama-manager
CacheDirectoryMode=0770
RuntimeDirectory=llama-manager
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/etc/llama-manager
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
