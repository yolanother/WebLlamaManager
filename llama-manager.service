# Copyright (c) Llama Manager project. Use of this file is governed by the
# LICENSE file in the repository root.
#
# Runs the immutable application from /usr/lib under the dedicated service
# account while granting write access only to the package-created configuration,
# state, cache, and runtime directories. The package-owned launcher reads only
# allowlisted path settings from group-managed configuration and constructs a
# clean environment before executing Node.

[Unit]
Description=Llama Manager API and Multi-Model Server
Documentation=https://github.com/yolanother/llama-manager
Wants=network-online.target
After=network-online.target
# Name this node before the manager answers on it. Wants= rather than an enabled
# unit keeps identity on exactly one enablement path -- the manager's own -- so a
# live USB boot and an installed disk both get it with no image-build or postinst
# step of their own.
Wants=llama-manager-identity.service
After=llama-manager-identity.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=llama-manager
Group=llama-manager
SupplementaryGroups=render video
WorkingDirectory=/usr/lib/llama-manager/api
ExecStartPre=/usr/bin/env -i HOME=/var/lib/llama-manager NODE_ENV=production LLAMA_MANAGER_PACKAGED=1 LLAMA_MANAGER_NODE_BIN=/usr/lib/llama-manager/node/bin/node PATH=/usr/bin:/bin /usr/lib/llama-manager/node/bin/node /usr/lib/llama-manager/scripts/check-node-runtime.mjs
ExecStart=/usr/bin/env -i /usr/lib/llama-manager/scripts/run-packaged-service
# Stop only the manager process, never its descendants.
#
# The engine runs in a rootless Podman container that distrobox starts on first
# entry, which places it in THIS SERVICE'S cgroup. Under the default
# KillMode=control-group, `systemctl restart llama-manager` therefore SIGTERMs
# the container along with the manager -- observed on the appliance as the engine
# container sitting at "Exited (143)" immediately after every restart, so the
# manager then failed to enter it and reported podman exit 125. The service was
# destroying the engine it was about to look for.
#
# The manager already stops llama-server explicitly by PID on shutdown, so
# nothing is leaked by leaving the cgroup alone here.
KillMode=process
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0007

ConfigurationDirectory=llama-manager
ConfigurationDirectoryMode=0770
StateDirectory=llama-manager
StateDirectoryMode=0770
CacheDirectory=llama-manager
CacheDirectoryMode=0770
RuntimeDirectory=llama-manager
RuntimeDirectoryMode=0700

# Rootless Podman/Distrobox requires the setuid newuidmap/newgidmap helpers to
# install subordinate-ID mappings; enabling NoNewPrivileges blocks that transition.
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/etc/llama-manager
# Rootless Podman must be able to create the engine container's cgroup, and
# ProtectControlGroups=yes mounts /sys/fs/cgroup READ-ONLY for this service.
#
# MEASURED ON THE APPLIANCE. With it enabled every engine start failed with
# podman exit 125 and the kiosk reported "no inference engine on this machine
# yet" -- while the very same launcher, with this service's exact environment,
# working directory and stdin, served on 8080 when run outside the unit. That
# asymmetry is what took several hypotheses to narrow: PrivateTmp and the
# missing TTY both reproduce SUCCESSFULLY outside the service, so neither was
# the cause. Relaxing this one directive alone takes the router from exit 125 to
# "Llama server restarted successfully" and 33 tok/s.
#
# This is a deliberate, narrow concession: the service can write cgroups, which
# it needs to run a container at all. Every other protection below stays on.
ProtectControlGroups=no

# The node's fleet advertisement. ProtectSystem=full makes all of /etc read-only,
# so owning the file is not enough on its own -- without this the manager gets
# EROFS and the appliance never appears to its peers, silently and with the file
# sitting there correctly owned. Measured on a live appliance, not theorised.
#
# Leading "-" because the path only exists where avahi-daemon is installed: a
# source checkout or a dev box has no /etc/avahi, and a missing ReadWritePaths
# entry without it refuses to start the unit at all.
ReadWritePaths=-/etc/avahi/services
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
# NOT enabled, though it is otherwise good hygiene here. This restriction is a
# seccomp filter, and seccomp is inherited by every descendant -- including the
# processes inside the engine container. distrobox initializes that container by
# upgrading util-linux and pam, whose payloads are setuid binaries (/usr/bin/mount,
# chfn, pam_timestamp_check); with this on, rpm cannot set their setuid bits and
# the transaction dies with "cpio: chmod failed", so container setup never
# completes and the engine never starts. Verified both ways on the appliance:
# with it, a chmod 4755 inside the container fails; without it, it succeeds.
# The container is a pinned, offline, first-party image, so its own setuid
# binaries are not the threat this option defends against.
RestrictSUIDSGID=no
LockPersonality=yes
# Mapping helpers need more than CAP_SETUID/CAP_SETGID, which is what this list
# used to assume. Rootless Podman builds the engine container's user namespace by
# exec'ing the distro's setuid-root /usr/bin/newuidmap, which writes
# /proc/<pid>/uid_map. The bounding set caps what even a setuid-root binary may
# hold, so without CAP_DAC_OVERRIDE and CAP_SYS_ADMIN that write fails with
#   newuidmap: open of uid_map failed: Permission denied
# and Podman exits 125 before any of our code runs -- which the manager then
# reported as "llama-server crashed".
#
# This is invisible in normal operation because it only bites when the container
# must be STARTED. `podman exec` into an already-running container joins the
# existing namespace and never calls newuidmap, so a freshly installed appliance
# looks healthy right up until the first restart, and then never recovers.
#
# The service itself holds none of these. It runs as llama-manager with
# CapEff = CAP_NET_BIND_SERVICE alone (verified on the appliance); the bounding
# set only permits the distro-shipped setuid helper to do its one job. Node
# receives CAP_NET_BIND_SERVICE as an ambient capability so the non-root service
# account can bind the appliance's port 80 dashboard listener (see ALT_PORT).
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
