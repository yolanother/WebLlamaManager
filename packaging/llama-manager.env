LLAMA_PORT=8080
EMBED_PORT=5252
MODELS_MAX=2
CONTEXT_SIZE=8192
AUTO_START=true
STATS_INTERVAL=1000
DISTROBOX_CONTAINER=llama-rocm-7.2.4
LLAMA_SERVER_BIN=/usr/local/bin/llama-server
