# Copyright (c) Llama Manager project. Use of this file is governed by the
# LICENSE file in the repository root.
#
# Only allowlisted scalar and path values here override service defaults. The
# package launcher validates scalars and ignores executable, container, loader,
# and language-runtime settings. Keep credentials out of this file; use the
# dashboard's protected configuration.

# WHERE THE ENGINE READS MODELS. /volumes is where the appliance mounts
# attached storage -- NFS on a real deployment, a bind mount of the medium in a
# live session -- so /volumes/models is the stable, source-agnostic location,
# and it is what the ROCm container is created with (--volume /volumes:/volumes)
# so the engine can see it at all.
#
# THIS MUST AGREE WITH iso/install-offline.sh, WHICH STAGES THE MODEL THERE.
# It did not, and the two halves were each self-consistent while together
# losing the model: the installer had moved to /volumes/models and deletes the
# old /var/lib/llama-manager/models copy as obsolete, while this file set
# nothing, so the manager fell back to $HOME/models and reported an appliance
# with no models at all -- including the Qwen3-8B that ships on the media.
# Measured on hardware: the GGUF was present at /volumes/models and the
# dashboard listed none.
MODELS_DIR=/volumes/models

API_PORT=3001
LLAMA_PORT=8080
EMBED_PORT=5252
MODELS_MAX=2
CONTEXT_SIZE=8192
AUTO_START=true
STATS_INTERVAL=1000
