# Llama Manager — machine-readable private-package runtime interface.
# Copyright (c) Llama Manager project. Use of this file is governed by the
# LICENSE file in the repository root.
#
# The private Debian/ISO build repository consumes these non-secret constants
# when staging offline runtimes. Paths are package-owned and must remain
# root:root, non-group-writable after installation.

LLAMA_MANAGER_APP_ROOT=/usr/lib/llama-manager
LLAMA_MANAGER_NODE_VERSION_MIN=20.18.1
LLAMA_MANAGER_NODE_BIN=/usr/lib/llama-manager/node/bin/node
LLAMA_MANAGER_NODE_PREFIX=/usr/lib/llama-manager/node
LLAMA_MANAGER_NODE_CHECK=/usr/lib/llama-manager/scripts/check-node-runtime.mjs
LLAMA_MANAGER_SERVICE_LAUNCHER=/usr/lib/llama-manager/scripts/run-packaged-service
LLAMA_MANAGER_LLAMA_LAUNCHER=/usr/lib/llama-manager/start-llama.sh
LLAMA_MANAGER_PRESET_LAUNCHER=/usr/lib/llama-manager/start-preset.sh
LLAMA_MANAGER_CONTAINER_START=/usr/lib/llama-manager/container-start.sh
LLAMA_MANAGER_DS4_LAUNCHER=/usr/lib/llama-manager/start-ds4.sh
LLAMA_MANAGER_CONTAINER_APP_ROOT=/run/host/usr/lib/llama-manager
LLAMA_MANAGER_DS4_BIN=/usr/lib/llama-manager-ds4/bin/ds4-server
LLAMA_MANAGER_CONTAINER_DS4_BIN=/run/host/usr/lib/llama-manager-ds4/bin/ds4-server
LLAMA_MANAGER_DISTROBOX_CONTAINER=llama-rocm-7.2.4
LLAMA_MANAGER_LLAMA_SERVER_BIN=/usr/local/bin/llama-server
LLAMA_MANAGER_STORAGE_CHECK=/usr/lib/llama-manager/scripts/check-model-storage.mjs
LLAMA_MANAGER_SERVICE_UNIT=/lib/systemd/system/llama-manager.service
LLAMA_MANAGER_CTL_BIN=/usr/bin/llama-managerctl
