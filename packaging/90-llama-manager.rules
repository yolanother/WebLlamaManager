// LICENSE file in the repository root.
//
// Allows members of the llama-manager group to start, stop, and restart only
// llama-manager.service. It intentionally grants no authority over other units,
// systemd manager operations, package installation, or general root commands.

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.isInGroup("llama-manager")) {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (unit == "llama-manager.service" &&
        ["start", "stop", "restart"].indexOf(verb) !== -1) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
