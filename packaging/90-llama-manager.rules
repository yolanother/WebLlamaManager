// Llama Manager — unit-scoped polkit authorization for service operators.
// Copyright (c) Llama Manager project. Use of this file is governed by the
// LICENSE file in the repository root.
//
// Allows members of the llama-manager group to start, stop, and restart only
// llama-manager.service and llama-manager-identity.service. The identity unit is
// included because renaming the node has to take effect live, and it is the one
// component permitted to change the hostname -- granting the manager the systemd
// unit instead of the hostname1 action keeps the privilege scoped to a single
// script whose behaviour is fixed by the package. It intentionally grants no
// authority over other units, systemd manager operations, package installation,
// or general root commands.

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.isInGroup("llama-manager")) {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var units = ["llama-manager.service", "llama-manager-identity.service"];
    if (units.indexOf(unit) !== -1 &&
        ["start", "stop", "restart"].indexOf(verb) !== -1) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
