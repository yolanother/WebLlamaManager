#!/bin/bash
# Llama Manager — boot-time node identity resolution and hostname application.
# Copyright (c) Llama Manager project. Use of this file is governed by the
# LICENSE file in the repository root.
#
# Decides what this appliance calls itself and makes that name the system
# hostname, which is the whole of the zero-configuration story: avahi-daemon
# already publishes <hostname>.local, so setting the hostname is sufficient to
# make the box reachable at <name>-llama-manager.local from any machine on the
# link with no configuration anywhere. Runs as root from
# llama-manager-identity.service, both at boot and again whenever the manager
# persists a newly chosen name.
#
# Resolution order is persistent state, then the live USB's writable partition,
# then the bootstrap name "setup". That order is what makes both directions
# correct with one rule: at a live boot the persistent path is an empty RAM
# overlay so the writable partition's copy wins and the box keeps the identity it
# was given, while immediately after the manager writes a new name the persistent
# path exists and the new name wins over the now-stale mirror.
#
# Nothing here is allowed to fail the unit. An appliance that cannot set its
# hostname is still an appliance that must start and serve, and the manager is
# ordered after this step.
set -uo pipefail

# Persistent store, written by this script and by the manager (which owns
# /var/lib/llama-manager through the unit's StateDirectory).
NAME_FILE="${LLAMA_MANAGER_NODE_NAME_FILE:-/var/lib/llama-manager/node-name}"

# Tool used to change the hostname. Overridable so the behaviour can be tested
# without touching the machine running the tests.
HOSTNAMECTL="${LLAMA_MANAGER_HOSTNAMECTL:-hostnamectl}"

# avahi's own configuration, edited so it never publishes on loopback.
AVAHI_CONF="${LLAMA_MANAGER_AVAHI_CONF:-/etc/avahi/avahi-daemon.conf}"

# Tool used to hand the persistent store back to the service account, and the
# account it is handed to. Overridable so the handover is observable in tests.
CHOWN="${LLAMA_MANAGER_CHOWN:-chown}"
STATE_OWNER="${LLAMA_MANAGER_STATE_OWNER:-llama-manager:llama-manager}"

# Live USB persistence. The partition is addressed by LABEL and mounted at its
# ROOT under /run for the moment it is needed, rather than reusing whatever mount
# it already has. Measured on real media: casper bind-mounts this partition into
# /var/log and /var/crash from a per-boot subdirectory named for the date
# (install-logs-2026-08-25.0/log), so anything written through those paths is in
# a directory the NEXT boot does not look at -- the name would be silently
# forgotten on exactly the reboot it exists to survive.
WRITABLE_DEVICE="${LLAMA_MANAGER_WRITABLE_DEVICE:-/dev/disk/by-label/writable}"
WRITABLE_MOUNT="${LLAMA_MANAGER_WRITABLE_MOUNT:-/run/llama-manager/writable}"
MIRROR_RELATIVE_PATH='llama-manager/node-name'
MOUNT="${LLAMA_MANAGER_MOUNT:-mount}"
UMOUNT="${LLAMA_MANAGER_UMOUNT:-umount}"

# Path of the mirror for this run, and whether this run is the one that mounted
# the partition and therefore owes it an unmount.
MIRROR_PATH=""
MIRROR_MOUNTED=0

# Tool used to ask avahi to re-announce this node. Overridable for tests.
SYSTEMCTL="${LLAMA_MANAGER_SYSTEMCTL:-systemctl}"

# Loopback alias file kept in step with the hostname. Overridable for tests.
HOSTS_FILE="${LLAMA_MANAGER_HOSTS_FILE:-/etc/hosts}"

# Name carried before any theme has been chosen. A freshly flashed box is
# addressable at setup-llama-manager.local from its very first boot.
BOOTSTRAP_NAME='setup'

# Longest name accepted, mirroring api/node-identity.js. A DNS label may be 63
# characters and "-llama-manager" costs 14, so this is a readability cap.
MAX_NAME_LENGTH=24

# Makes the live USB's writable partition available and sets MIRROR_PATH.
#
# An explicit override wins outright, which is how "this is an installed disk
# with no mirror" is expressed (empty) and how the behaviour is tested without a
# partition. Otherwise the labelled partition is mounted at its root; every
# failure just leaves MIRROR_PATH empty, because losing persistence is worth a
# shrug and never a failed boot.
open_mirror() {
  if [[ -n "${LLAMA_MANAGER_NODE_NAME_MIRROR+x}" ]]; then
    MIRROR_PATH="$LLAMA_MANAGER_NODE_NAME_MIRROR"
    return 0
  fi
  # Existence rather than a block-device test: the label is either there or it is
  # not, and mount is the honest arbiter of whether it can be used. Anything that
  # cannot be mounted falls through to "no mirror" like every other failure here.
  [[ -e "$WRITABLE_DEVICE" ]] || return 0
  mkdir -p "$WRITABLE_MOUNT" 2>/dev/null || return 0
  if ! findmnt --noheadings --mountpoint "$WRITABLE_MOUNT" >/dev/null 2>&1; then
    "$MOUNT" "$WRITABLE_DEVICE" "$WRITABLE_MOUNT" 2>/dev/null || return 0
    MIRROR_MOUNTED=1
  fi
  MIRROR_PATH="$WRITABLE_MOUNT/$MIRROR_RELATIVE_PATH"
  return 0
}

# Releases the writable partition if this run mounted it, so the appliance is not
# left holding a mount nobody asked for.
close_mirror() {
  if [[ "$MIRROR_MOUNTED" == 1 ]]; then
    "$UMOUNT" "$WRITABLE_MOUNT" 2>/dev/null || \
      printf 'llama-manager-identity: could not release %s\n' "$WRITABLE_MOUNT" >&2
    MIRROR_MOUNTED=0
  fi
  return 0
}

# Folds arbitrary stored text into a legal single mDNS label.
#
# This deliberately repeats the rules in api/node-identity.js rather than calling
# into Node. It is a defensive re-check of a file, not the primary validator --
# the manager normalises before it ever writes -- and it has to work at boot with
# nothing but coreutils. Prints nothing when no usable name remains.
normalize_name() {
  printf '%s' "$1" \
    | tr 'A-Z' 'a-z' \
    | tr -c 'a-z0-9' '-' \
    | tr -s '-' \
    | sed -e 's/^-//' -e 's/-$//' \
    | cut -c "1-$MAX_NAME_LENGTH" \
    | sed -e 's/-$//'
}

# Reads one store file and prints the normalized name it holds, or nothing.
read_name_file() {
  local path="$1"
  [[ -n "$path" && -r "$path" ]] || return 0
  normalize_name "$(cat "$path" 2>/dev/null)"
}

# Stops avahi publishing this host on loopback, which makes it collide with
# itself and rename the node out from under us.
#
# MEASURED ON HARDWARE. avahi joins mDNS on `lo` seconds before the real
# interface exists, publishes the hostname there, and then re-probes when the
# real interface appears -- at which point it finds its OWN loopback record and
# treats it as another machine:
#
#   Host name conflict, retrying with setup-llama-manager-2
#   Server startup complete. Host name is setup-llama-manager-2.local.
#
# The node is then reachable only at a name nobody would guess. Nothing detects
# it either: this script compares the SYSTEM hostname, which is still correct,
# and the /etc/hosts alias makes on-box resolution succeed, so every local check
# passes while every remote one fails.
#
# An existing deny list is extended rather than replaced -- an operator may have
# denied an interface deliberately, and silently dropping that would be its own
# defect.
deny_loopback_publication() {
  local conf="$AVAHI_CONF" existing
  [[ -f "$conf" ]] || return 0

  existing="$(sed -n 's/^deny-interfaces=//p' "$conf" | head -n 1)"
  if [[ -n "$existing" ]]; then
    case ",${existing//[[:space:]]/}," in
      *,lo,*) return 0 ;;
    esac
    sed -i "s|^deny-interfaces=.*|deny-interfaces=${existing},lo|" "$conf" || return 0
  elif grep -q '^\[server\]' "$conf"; then
    sed -i '0,/^\[server\]/s//[server]\ndeny-interfaces=lo/' "$conf" || return 0
  else
    printf '[server]\ndeny-interfaces=lo\n' >> "$conf" || return 0
  fi
  printf 'llama-manager-identity: avahi will not publish on loopback\n'
}

# Prints the name this node should answer to, applying the resolution order
# documented at the top of this file. Never prints an empty string.
resolve_name() {
  local name
  name="$(read_name_file "$NAME_FILE")"
  [[ -n "$name" ]] || name="$(read_name_file "$MIRROR_PATH")"
  [[ -n "$name" ]] || name="$BOOTSTRAP_NAME"
  printf '%s\n' "$name"
}

# Writes a name to a store path, creating its directory. Failures are reported
# and swallowed: losing persistence is worth a warning, never a failed boot.
persist_name() {
  local path="$1" name="$2"
  [[ -n "$path" ]] || return 0
  mkdir -p "$(dirname "$path")" 2>/dev/null || {
    printf 'llama-manager-identity: cannot create %s\n' "$(dirname "$path")" >&2
    return 0
  }
  printf '%s\n' "$name" > "$path" 2>/dev/null || \
    printf 'llama-manager-identity: cannot write %s\n' "$path" >&2
  return 0
}

# Points the 127.0.1.1 loopback alias at the current hostname.
#
# hostnamectl does not touch /etc/hosts, and Debian's convention is that the
# machine's own name resolves through that alias. Leaving it stale is what
# produces "sudo: unable to resolve host" and a multi-second stall on every
# privileged command -- a small thing that makes a renamed appliance feel broken.
# The line is rewritten in place, or appended when the file has no alias at all,
# and nothing else in the file is touched.
update_hosts_alias() {
  local hostname="$1" tmp
  [[ -w "$HOSTS_FILE" ]] || return 0
  tmp="$(mktemp "${HOSTS_FILE}.XXXXXX" 2>/dev/null)" || return 0
  if grep -q '^127\.0\.1\.1[[:space:]]' "$HOSTS_FILE"; then
    sed -e "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t$hostname/" "$HOSTS_FILE" > "$tmp"
  else
    cat "$HOSTS_FILE" > "$tmp"
    printf '127.0.1.1\t%s\n' "$hostname" >> "$tmp"
  fi
  # Written back through the existing inode rather than renamed over it, so the
  # file keeps its ownership and mode and a /etc/hosts that is a symlink stays
  # one. The staging file means sed never reads a file it is writing.
  cat "$tmp" > "$HOSTS_FILE" 2>/dev/null || \
    printf 'llama-manager-identity: cannot update %s\n' "$HOSTS_FILE" >&2
  rm -f "$tmp"
  return 0
}

# Resolves the identity, publishes it as the system hostname, and writes it back
# to every store so the next boot -- live or installed -- finds it first.
apply_identity() {
  local name hostname current
  open_mirror
  name="$(resolve_name)"
  hostname="$name-llama-manager"

  # Write both stores unconditionally. On a live boot this copies the writable
  # partition's name into the RAM overlay; after the manager chooses a name it
  # copies the new name out onto the writable partition. One unconditional write
  # covers both because resolve_name has already picked the winner.
  persist_name "$NAME_FILE" "$name"

  # This script runs as root but the manager, which runs as llama-manager, has to
  # be able to write the same file when an operator picks a new name. A file
  # created here on a first boot would otherwise be root-owned and the manager
  # would silently lose the ability to rename the node. The package's tmpfiles
  # policy seeds the file with the right ownership too; this covers source
  # installs and any path where tmpfiles has not run.
  "$CHOWN" "$STATE_OWNER" "$NAME_FILE" 2>/dev/null || true

  # The mirror lives on the live USB's writable partition and is only ever
  # touched by root, so it is deliberately not handed over.
  persist_name "$MIRROR_PATH" "$name"

  deny_loopback_publication
  update_hosts_alias "$hostname"

  current="$("$HOSTNAMECTL" hostname 2>/dev/null)"
  if [[ "$current" == "$hostname" ]]; then
    printf 'llama-manager-identity: already published as %s.local\n' "$hostname"
    return 0
  fi

  if "$HOSTNAMECTL" set-hostname "$hostname" 2>/dev/null; then
    # Measured on the appliance: avahi-daemon does NOT notice a hostname change.
    # It keeps answering for the name it started with -- so a renamed box was
    # reachable at its OLD .local address and never at its new one, which is the
    # entire feature. avahi re-reads the system hostname at startup, so bouncing
    # it is what actually publishes the new name. try-restart rather than restart
    # so this is a no-op at boot, where this step runs before avahi has started
    # and avahi will read the correct hostname on its own.
    #
    # --no-block is load-bearing. This unit is ordered Before= avahi-daemon, so a
    # blocking restart asks systemd for a job that is ordered after the job that
    # is waiting on it. That deadlocks the transaction, times out, and leaves
    # avahi STOPPED -- the box then has no mDNS at all, which is far worse than
    # the stale name this call exists to fix. Measured on a live appliance.
    "$SYSTEMCTL" --no-block try-restart avahi-daemon.service 2>/dev/null || \
      printf 'llama-manager-identity: could not ask avahi to re-announce\n' >&2
    printf 'llama-manager-identity: published as %s.local\n' "$hostname"
  else
    # A box that cannot set its hostname still has to boot and serve. It stays
    # reachable by IP, and the manager is ordered after this step precisely so a
    # failure here cannot keep the appliance down.
    printf 'llama-manager-identity: could not set hostname to %s\n' "$hostname" >&2
  fi
  return 0
}

case "${1:-apply}" in
  apply)
    apply_identity
    close_mirror
    ;;
  show)
    open_mirror
    resolve_name
    close_mirror
    ;;
  *)
    printf 'Usage: %s [apply|show]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
exit 0
