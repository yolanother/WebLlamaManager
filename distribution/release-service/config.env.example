#
# Optional overrides for the automatic Llama Manager release service. Copy to
# `config.env` (which is git-ignored) and edit only the values that differ from
# the defaults baked into release-runner.sh / watch-main.sh. This file must NOT
# contain any secret (the signing passphrase lives only in the operator-written
# 0600 file under the private signing tree, never here).

# Repositories and toolchain
# APP_REPO=/home/yolan/workspace/ai/llama-server
# RESPIN_REPO=/home/yolan/workspace/ai/llama-server/.claude/worktrees/llama-manager-ubuntu-respin-src
# BUILDER_IMAGE=localhost/llama-manager-builder:24.04

# Staged build inputs (base ISO, ROCm OCI, Qwen model, DS4 binary, Node tar,
# kernel + ubuntu-dependency debs). Reuse the newest verified snapshot.
# INPUTS_DIR=/volumes/llama-manager/private/inputs/20260714T235007Z-production

# NAS output roots (public + private must share one filesystem)
# NAS_ROOT=/volumes/llama-manager
# PUBLIC_DIR=/volumes/llama-manager/public
# SIGNING_ROOT=/volumes/llama-manager/private/signing

# Live download host (thromgar)
# THROMGAR_HOST=root@65.181.123.88
# THROMGAR_PATH=/volumes/llama-manager.doubtech.ai/public
# PUBLIC_BASE_URL=https://llama-manager.doubtech.ai
# THROMGAR_MIN_FREE_MIB=9000

# Debounce: how long a new commit must be the stable HEAD before a build fires.
# QUIET_WINDOW_SECONDS=600
